<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>HyperPlot.Rendering.D3D11.Tests</RootNamespace>
    <!-- The allocation test reads GC.GetAllocatedBytesForCurrentThread; tiering could allocate in its window (.cursor/rules/bench.mdc). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HyperPlot.Rendering.D3D11\HyperPlot.Rendering.D3D11.csproj" />
    <ProjectReference Include="..\..\src\HyperPlot.Testing\HyperPlot.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The scene of HelloPlot, drawn for its golden image with 1e5 points (design §10.1). -->
    <Compile Include="..\..\samples\Shared\PlotArea.cs" Link="Golden\PlotArea.cs" />
    <Compile Include="..\..\samples\Shared\HelloScene.cs" Link="Golden\HelloScene.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
