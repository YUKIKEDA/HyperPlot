<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>HyperPlot.Rendering.D3D11.Tests</RootNamespace>
    <!-- The allocation test reads GC.GetAllocatedBytesForCurrentThread; tiering could allocate in its window (.cursor/rules/bench.mdc). -->
    <TieredCompilation>false</TieredCompilation>
    <!-- The Direct3D 9Ex reader of the surface tests calls COM vtables (row W1a). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HyperPlot.Rendering.D3D11\HyperPlot.Rendering.D3D11.csproj" />
    <ProjectReference Include="..\..\src\HyperPlot.Testing\HyperPlot.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The scene of HelloPlot, drawn for its golden image with 1e5 points (design §10.1). -->
    <Compile Include="..\..\samples\Shared\PlotArea.cs" Link="Golden\PlotArea.cs" />
    <Compile Include="..\..\samples\Shared\HelloScene.cs" Link="Golden\HelloScene.cs" />
    <!-- The fake text backend of the T1 tests, shared with the Core tests (design §10). -->
    <Compile Include="..\HyperPlot.Core.Tests\Rendering\FakeTextBackend.cs" Link="Text\FakeTextBackend.cs" />
    <!-- The storage whose worker reads a test holds, shared with the Core tests: the coarse density's scene (row R3b1). -->
    <Compile Include="..\HyperPlot.Core.Tests\Data\TestStorage.cs" Link="Data\TestStorage.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
