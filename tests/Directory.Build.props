<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!--
      The zero-allocation tests read GC.GetAllocatedBytesForCurrentThread. When a background GC finishes its mark, the runtime
      empties every thread's allocation context without taking the unused rest off the thread's count, so a test that allocated
      nothing can count a few KB that another test's garbage caused (.cursor/rules/bench.mdc). Without concurrent GC
      there is no background GC. The tests measure the code's allocations, which do not depend on the GC's mode; apps and
      benchmarks keep the default.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dumps a test process that stops: build.ps1 turns it on (Issue #260). -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>
  <!--
    xUnit runs the tests in the order of their unique IDs, and the test assembly's ID is a hash of the assembly's path unless a
    file named after the assembly with the extension .uniqueid lies beside it; its first line is then the ID (xunit.v3 3.0.1 and
    later, "What's New in v3" on xunit.net; UniqueIDGenerator.ForAssembly). With the file, the order is the same in every
    checkout and on CI: without it, which WPF test failed depended on the worktree's folder (Issue #299).
  -->
  <Target Name="WriteTestAssemblyUniqueId" AfterTargets="Build" Condition="'$(OutputType)' == 'Exe'">
    <WriteLinesToFile File="$(OutDir)$(AssemblyName).uniqueid" Lines="$(AssemblyName)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)$(AssemblyName).uniqueid" />
    </ItemGroup>
  </Target>
</Project>
