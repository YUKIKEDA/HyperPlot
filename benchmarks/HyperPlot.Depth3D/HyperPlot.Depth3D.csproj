<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPIKE (row K1, Issue #509): how 3D polylines and markers composite with depth, on D3D11 headless and against a CPU reference. Not product code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>HyperPlot.Depth3D</RootNamespace>
    <!-- Figures are taken from the NativeAOT Release build (.cursor/rules/bench.mdc). -->
    <PublishAot>true</PublishAot>
    <!-- D3D11 is called through its COM vtables, as in the backend (.cursor/rules/interop.mdc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" />
  </ItemGroup>
</Project>
