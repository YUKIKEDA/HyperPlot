<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>HyperPlot</RootNamespace>
    <Description>The HyperPlot engine: columns and indexes, the grammar of graphics, interaction, and the render IR.</Description>
    <!-- Native and memory-mapped column storage hands out spans over unmanaged memory (design §3.2). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HyperPlot.Core.Tests" />
    <!-- The kernel benchmarks call the internal kernels; the data-path harness reads the size of the pyramid's blocks. -->
    <InternalsVisibleTo Include="HyperPlot.Benchmarks" />
    <InternalsVisibleTo Include="HyperPlot.DataPath" />
    <!-- The D3D11 backend premultiplies and takes out the alpha with Core's integer forms (design §5.2). -->
    <InternalsVisibleTo Include="HyperPlot.Rendering.D3D11" />
    <!-- The image pipeline's tests write tile records and fill the residency cache by hand (row G9): DrawImage is internal. -->
    <InternalsVisibleTo Include="HyperPlot.Rendering.D3D11.Tests" />
    <!-- GoldenImage writes the actual and diff images with the same PNG writer as HeadlessRenderer (design §10.1). -->
    <InternalsVisibleTo Include="HyperPlot.Testing" />
  </ItemGroup>
</Project>
