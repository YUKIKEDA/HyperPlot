root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,xml,config}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
# Layout is owned by CSharpier (.csharpierrc.json). Rules below cover naming, style, and analyzers only.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning

# No this. qualification.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Modern C# is allowed (docs/conventions.md): var when the type is apparent, collection expressions,
# target-typed new, primary constructors. The IDE does not force either form.
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = true:none
csharp_style_var_elsewhere = false:none
csharp_style_prefer_primary_constructors = true:none
dotnet_style_prefer_collection_expression = when_types_loosely_match:none

# Namespaces follow assembly names, not folders (docs/conventions.md).
dotnet_diagnostic.IDE0130.severity = none

# Naming: private fields are _camelCase, static ones included. Constants are PascalCase.
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.constant_fields_pascal.symbols = constant_fields
dotnet_naming_rule.constant_fields_pascal.style = pascal_case
dotnet_naming_rule.constant_fields_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

# Interfaces start with I.
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = warning

# CA rules that fight deliberate performance shapes in this repository (.cursor/rules/perf.mdc).
# CA1815: value types used as chunk headers, LOD entries, GPU records, and handles do not need Equals overrides unless compared.
dotnet_diagnostic.CA1815.severity = none
# CA1051: internal structs of column chunks and GPU records expose fields on purpose (ref access, no property copies).
dotnet_diagnostic.CA1051.severity = none
# CA1716 / CA1720: names such as Double, Single, Pointer, Shared, and Step are domain words here (column types, pointer
# interaction, shared textures, step lines).
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none

# StyleCop: rules that conflict with CSharpier or with .NET naming.
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1306.severity = none
dotnet_diagnostic.SA1310.severity = none
dotnet_diagnostic.SA1311.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1111.severity = none
dotnet_diagnostic.SA1502.severity = none
# CSharpier puts an empty block on one line (`using (scope) { }`); SA1501 rejects that layout.
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1401.severity = none
dotnet_diagnostic.SA1649.severity = none
dotnet_diagnostic.SA1402.severity = none
# File headers are not used.
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1636.severity = none

# Default: no XML docs required (tests, tools, samples, benchmarks).
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1618.severity = none
dotnet_diagnostic.CS1591.severity = none

# src/: the public API needs XML docs. Internal members do not (docs/conventions.md).
[src/**/*.cs]
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1601.severity = warning
dotnet_diagnostic.SA1602.severity = warning
dotnet_diagnostic.SA1611.severity = warning
dotnet_diagnostic.SA1615.severity = warning
dotnet_diagnostic.SA1618.severity = warning
dotnet_diagnostic.CS1591.severity = warning
dotnet_diagnostic.SA1623.severity = warning
dotnet_diagnostic.SA1629.severity = warning
dotnet_diagnostic.SA1642.severity = warning

# Tests: names are {Target}_{Scenario}_{Expected} (.cursor/rules/testing.mdc), which CA1707 rejects.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Generated code.
[*.g.cs]
generated_code = true
