<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- An Exe, not a WinExe, so that the measure option prints to the console. WPF runs on the JIT only (.cursor/rules/aot.mdc). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HyperPlot.Samples</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HyperPlot.Wpf\HyperPlot.Wpf.csproj" />
  </ItemGroup>
</Project>
